# Neon Postgres connection string (from Vercel/Neon integration)
DATABASE_URL=

# Pingram API key (https://www.pingram.io)
PINGRAM_API_KEY=

# Verified sender address for Pingram (optional, defaults to hello@ekofirst.org)
PINGRAM_FROM_ADDRESS=

# If set, receives an email notification for every new registration
ADMIN_EMAIL=
